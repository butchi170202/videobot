# ==============================================================================
# CẤU HÌNH TELEGRAM BOT & GOOGLE GEMINI API (BẢN CÁ NHÂN GỌN NHẸ)
# ==============================================================================

# 1. Token của Telegram Bot (@videot17_bot)
TELEGRAM_BOT_TOKEN=9001573362:AAF0T4KaompopbspNODHfEmnhbuU3ISym2g

# 2. Danh sách Telegram User ID được phép dùng Bot (Cách nhau bằng dấu phẩy)
# Để trống để bạn có thể vào dùng ngay; khi muốn khóa chỉ cho riêng bạn thì điền ID vào đây
ALLOWED_USER_IDS=

# 3. Google Gemini API Key (Lấy từ https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSyAYMHZ4puQEcwgZrX0jE2ldHQkkBtJCXXw

# 4. Chế độ dùng thử miễn phí (Mock Mode)
# Đang bật true để bạn test thử Bot @videot17_bot ngay lập tức trên Telegram.
# Khi bạn điền GEMINI_API_KEY thật ở mục 3, hãy đổi thành false.
GEMINI_MOCK_MODE=false

# 5. Cấu hình Google Cloud Vertex AI (Tùy chọn)
USE_VERTEX_AI=false
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# 6. Cấu hình Model mặc định
DEFAULT_VIDEO_MODEL=veo-3.1-fast-generate-preview
PROMPT_OPTIMIZER_MODEL=gemini-2.5-flash

# 7. Giới hạn an toàn & hệ thống
MAX_CONCURRENT_TASKS=2
POLL_INTERVAL_SECONDS=10
MAX_WAIT_SECONDS=360
MAX_IMAGE_SIZE_MB=10
LOG_LEVEL=INFO

