# ==============================================================================
# CẤU HÌNH TELEGRAM BOT & GOOGLE GEMINI API (BẢN CÁ NHÂN GỌN NHẸ)
# ==============================================================================

# 1. Token của Telegram Bot (Lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Danh sách Telegram User ID được phép dùng Bot (Cách nhau bằng dấu phẩy)
# Để trống nếu muốn ai cũng dùng được, nhưng KHUYÊN DÙNG điền ID của bạn để bảo vệ API Key!
# Cách lấy ID: Nhắn tin cho @userinfobot trên Telegram
ALLOWED_USER_IDS=123456789

# 3. Google Gemini API Key (Lấy từ https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Chế độ dùng thử miễn phí (Mock Mode)
# - true: Giả lập tạo video bằng file MP4 mẫu (KHÔNG tốn tiền API, dùng để test Bot)
# - false: Gọi API Google Veo thật để tạo video AI
GEMINI_MOCK_MODE=false

# 5. Cấu hình Google Cloud Vertex AI (Tùy chọn - nếu bạn dùng gói $300 Free Trial của GCP)
USE_VERTEX_AI=false
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# 6. Cấu hình Model mặc định
DEFAULT_VIDEO_MODEL=veo-3.1-fast-generate-preview
PROMPT_OPTIMIZER_MODEL=gemini-2.5-flash

# 7. Giới hạn an toàn & hệ thống
MAX_CONCURRENT_TASKS=2
POLL_INTERVAL_SECONDS=10
MAX_WAIT_SECONDS=360
MAX_IMAGE_SIZE_MB=10
LOG_LEVEL=INFO

